{
  "name": "@mednours/backon",
  "version": "0.5.0",
  "type": "module",
  "description": "Opinionated backend framework wrapper for Bun. Wraps Hono (default) or Express (via @mednours/backon/express) with the same baked-in security, logging, and validation defaults.",
  "license": "MIT",
  "homepage": "https://github.com/mednours/backon/tree/main/packages/backon#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mednours/backon.git",
    "directory": "packages/backon"
  },
  "bugs": "https://github.com/mednours/backon/issues",
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./express": "./src/express/index.ts"
  },
  "files": ["src"],
  "scripts": {
    "dev": "bun run --watch examples/dev-server.ts",
    "dev:express": "bun run --watch examples/dev-server-express.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "pino": "^9.5.0",
    "zod": "^3.25.28",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "ws": "^8.18.0",
    "multer": "^1.4.5"
  },
  "peerDependenciesMeta": {
    "express": { "optional": true },
    "cors": { "optional": true },
    "helmet": { "optional": true },
    "compression": { "optional": true },
    "ws": { "optional": true },
    "multer": { "optional": true }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "@types/multer": "^1.4.12",
    "typescript": "^5.7.2",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "ws": "^8.18.0",
    "multer": "^1.4.5-lts.1",
    "supertest": "^7.0.0"
  }
}
